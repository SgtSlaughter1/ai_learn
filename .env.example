APP_NAME="PassPoint"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=offline_ai_learning
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# Mail Configuration Options
# ==========================================
# Option 1: Resend (3,000 free emails/month - https://resend.com)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_resend_api_key_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Option 2: Mailjet (6,000 free emails/month / 200 daily - https://app.mailjet.com)
# MAIL_MAILER=smtp
# MAIL_HOST=in-v3.mailjet.com
# MAIL_PORT=587
# MAIL_USERNAME=your_mailjet_api_key
# MAIL_PASSWORD=your_mailjet_secret_key
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="your_verified_mailjet_email@domain.com"
# MAIL_FROM_NAME="${APP_NAME}"

# Option 3: Offline / Local development (No internet needed)
# Set MAIL_MAILER=log (all password reset emails will be written to storage/logs/laravel.log)

# ==========================================
# AI Provider Configuration
# ==========================================
# Options: gemini, openai, local
AI_PROVIDER=gemini
AI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api
